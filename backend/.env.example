# =============================================================================
# ONE ROOFTOP RESTAURANT - ENVIRONMENT VARIABLES
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplacer les valeurs par vos configurations réelles
# 3. Ne jamais commiter .env dans Git
#
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------

# Environment: development | production | testing
DJANGO_ENVIRONMENT=development

# CRITICAL: Générer une clé sécurisée en production
# Commande: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars

# Debug mode (JAMAIS True en production)
DEBUG=True

# Hosts autorisés (séparés par des virgules)
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------

# PostgreSQL Connection
POSTGRES_DB=one_rooftop_db
POSTGRES_USER=one_rooftop_user
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (alternative format utilisé par certains packages)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://one_rooftop_user:change_this_secure_password_in_production@localhost:5432/one_rooftop_db

# -----------------------------------------------------------------------------
# CORS - Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------

# Frontend URLs autorisées (séparées par des virgules)
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Autoriser les credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------

# Durée de vie des tokens (en minutes)
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# Algorithm de signature JWT
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# FASTAPI SETTINGS
# -----------------------------------------------------------------------------

# FastAPI Title & Description (pour la doc)
FASTAPI_TITLE=One Rooftop Restaurant API
FASTAPI_DESCRIPTION=High-performance API endpoints for analytics and real-time features
FASTAPI_VERSION=1.0.0

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optionnel - pour notifications futures)
# -----------------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# -----------------------------------------------------------------------------
# REDIS (Optionnel - pour cache et Celery futurs)
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# STATIC & MEDIA FILES
# -----------------------------------------------------------------------------

# Static files URL
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# Media files URL
MEDIA_URL=/media/
MEDIA_ROOT=media/

# -----------------------------------------------------------------------------
# SECURITY SETTINGS (Production uniquement)
# -----------------------------------------------------------------------------

# HTTPS seulement
SECURE_SSL_REDIRECT=False

# HSTS
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Cookie sécurisé
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# -----------------------------------------------------------------------------
# DOCKER SETTINGS
# -----------------------------------------------------------------------------

# Container names
DOCKER_POSTGRES_CONTAINER=one-rooftop-postgres
DOCKER_DJANGO_CONTAINER=one-rooftop-django
DOCKER_FASTAPI_CONTAINER=one-rooftop-fastapi
